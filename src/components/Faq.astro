---
import type { FaqItem } from "../data/faq";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  em: string;
  faqs: FaqItem[];
}

const { id, eyebrow, title, em, faqs } = Astro.props;
---

<section class="section" id={id}>
  <div class="wrap faq-wrap">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="display">
        {title} <em>{em}</em>
      </h2>
    </div>
    <div class="faq-list reveal">
      {
        faqs.map((f) => (
          <details class="faq-item">
            <summary>
              {f.q}
              <span class="plus" aria-hidden="true">+</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    max-width: 768px;
  }

  .faq-list {
    margin-top: 48px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-container);
    background: var(--surface);
    box-shadow: var(--shadow-whisper);
    overflow: hidden;
  }

  .faq-item {
    border-top: 1px solid var(--oat);
  }

  .faq-item:first-child {
    border-top: 0;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    cursor: pointer;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 560;
    letter-spacing: -0.005em;
    transition: background-color 160ms var(--ease-out);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    background: var(--canvas);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--fin);
    outline-offset: -2px;
  }

  .plus {
    flex-shrink: 0;
    color: var(--ink-50);
    font-weight: 400;
    font-size: 1.125rem;
    transition: transform 200ms var(--ease-out);
  }

  .faq-item[open] .plus {
    transform: rotate(45deg);
    color: var(--fin-deep);
  }

  .faq-item p {
    margin: 0;
    padding: 0 24px 20px;
    font-size: 0.9375rem;
    color: var(--ink-60);
    max-width: 42rem;
  }
</style>
