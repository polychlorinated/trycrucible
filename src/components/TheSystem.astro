---
const steps = [
  { num: "01", title: "Find your inspiration", body: "The Topics tracker surfaces what your market is talking about — and where the greenspace is yours." },
  { num: "02", title: "Record your raw thoughts", body: "Brain dump, walk-and-talk, or an AI-guided interview that draws your best ideas out." },
  { num: "03", title: "Edit automated multi-channel results", body: "Clips, carousel slides, deep dives, and written posts in your voice — polish by clicking any word in the transcript." },
  { num: "04", title: "Publish and monitor your brand growth", body: "Download or publish straight to your connected platforms, then watch your presence compound with built-in engagement analytics." },
];
---

<section class="section section--wash" id="how-it-works">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">The Crucible System</p>
      <h2 class="display">From raw thought to <em>shipped content</em> in four steps.</h2>
    </div>
    <div class="steps">
      {
        steps.map((s) => (
          <article class="card step reveal">
            <span class="step-num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>
    <p class="system-cta reveal">
      <a class="btn" href="/how-it-works/">See how it works →</a>
    </p>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .step {
    display: flex;
    flex-direction: column;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-bottom: 20px;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--canvas);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .step h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 540;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .step p {
    margin: 10px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .system-cta {
    margin: 40px 0 0;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
