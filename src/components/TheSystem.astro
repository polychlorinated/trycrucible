---
const steps = [
  { num: "01", title: "Research & Plan", body: "Use Crucible as a lab for what to say next: market signals uncover competitor gaps and trending topics, matched to your editorial backlog and prep questions." },
  { num: "02", title: "Record your real thoughts", body: "Brain dump, walk-and-talk, or guided by an AI interview host that draws out your best insights in your authentic voice." },
  { num: "03", title: "Automate zero-slop drafts", body: "Clips, carousels on LinkedIn, deep dives, and articles derived from your verbatim words — approve, edit in-app, or schedule in one click." },
  { num: "04", title: "Measure & compound", body: "Built-in analytics track what resonates across channels, feeding performance signals right back into your research loop for what to tackle next." },
];
---

<section class="section section--wash" id="how-it-works">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">The Crucible System</p>
      <h2 class="display">From raw thought to <em>shipped content</em> in four steps.</h2>
    </div>
    <div class="steps">
      {
        steps.map((s) => (
          <article class="card step reveal">
            <span class="step-num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>
    <p class="system-cta reveal">
      <a class="btn" href="/how-it-works/">See how it works →</a>
    </p>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .step {
    display: flex;
    flex-direction: column;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-bottom: 20px;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--canvas);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .step h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 540;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .step p {
    margin: 10px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .system-cta {
    margin: 40px 0 0;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
