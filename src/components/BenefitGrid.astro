---
interface Card {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  em: string;
  cards: Card[];
}

const { eyebrow, title, em, cards } = Astro.props;
---

<section class="section section--wash">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="display">
        {title} <em>{em}</em>
      </h2>
    </div>
    <div class="benefits">
      {
        cards.map((c) => (
          <article class="card benefit reveal">
            <span class="benefit-dot" aria-hidden="true"></span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .benefits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    align-items: start;
  }

  .benefit-dot {
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 2px;
    background: var(--fin);
  }

  .benefit:nth-child(4n + 2) .benefit-dot {
    background: var(--report-blue);
  }

  .benefit:nth-child(4n + 3) .benefit-dot {
    background: var(--report-lime);
  }

  .benefit:nth-child(4n + 4) .benefit-dot {
    background: var(--report-pink);
  }

  .benefit h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .benefit p {
    grid-column: 2;
    margin: 8px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  @media (max-width: 768px) {
    .benefits {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
