---
import { pricingPlans, singleCreditNote } from "../data/pricing";
---

<section class="section section--wash" id="pricing">
  <div class="wrap">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Pricing</p>
      <h2 class="display">Start free. <em>Pay when it’s proven.</em></h2>
      <p class="lede">
        Every plan starts with a single credit for your first project — free. No credit cards, feature
        gates, or watermarks to slow you down.
      </p>
    </div>
    <div class="tiers">
      {
        pricingPlans.map((plan) => (
          <article
            class:list={[
              "card",
              "tier",
              { "card--highlight": plan.featured, "tier--muted": plan.muted },
            ]}
            data-od-id={`pricing-card-${plan.name.toLowerCase().replace(/[^a-z]+/g, "-")}`}
          >
            <div class="tier-head">
              <h3>{plan.name}</h3>
              {
                plan.badge && <span class="badge">{plan.badge}</span>
              }
            </div>
            <p class:list={["tier-price", { "is-muted": plan.muted }]}>
              {plan.price}
              {plan.per && <span class="per">{plan.per}</span>}
            </p>
            {
              plan.blurb && <p class="tier-blurb">{plan.blurb}</p>
            }
            {
              plan.features.length > 0 && (
                <ul class="tier-features">
                  {plan.features.map((f) => (
                    <li>
                      <span class="mark" aria-hidden="true">✓</span>
                      {f}
                    </li>
                  ))}
                </ul>
              )
            }
            {
              plan.creditNote && <p class="credit-note">{plan.creditNote}</p>
            }
            <a
              class:list={["btn", "btn--block", { "btn--fin": plan.featured, "btn--outline": !plan.featured }]}
              href={plan.cta.href}
            >
              {plan.cta.label}
            </a>
          </article>
        ))
      }
    </div>
    <p class="pricing-subtext reveal" data-od-id="pricing-single-credit-note">
      {singleCreditNote.prefix}
      <a href="https://app.trycrucible.com/login">{singleCreditNote.linkLabel}</a>
      {singleCreditNote.suffix}
    </p>
    <div class="launch-form reveal">
      <p class="launch-form-label">Get launch updates</p>
      <form class="email-form" action="#" method="post" data-capture-form>
        <input type="email" name="email" placeholder="you@yourbusiness.com" aria-label="Email address" required />
        <button class="btn" type="submit">Notify me</button>
      </form>
    </div>
  </div>
</section>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 56px;
    align-items: stretch;
  }

  .tier {
    display: flex;
    flex-direction: column;
  }

  .tier--muted {
    border-style: dashed;
    border-color: var(--sand);
    background: var(--wash);
    box-shadow: none;
  }

  .tier-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tier h3 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 540;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .badge {
    padding: 4px 8px;
    border-radius: var(--radius-control);
    background: var(--fin);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin: 16px 0 0;
    font-size: 1.75rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .tier-price.is-muted {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .tier-price .per {
    font-size: 0.9375rem;
    font-weight: 460;
    color: var(--ink-50);
  }

  .tier-blurb {
    margin: 14px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .tier-features {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .tier-features li {
    display: flex;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-80);
  }

  .tier--muted .tier-features li {
    color: var(--ink-60);
  }

  .mark {
    flex-shrink: 0;
    color: var(--fin-deep);
    font-weight: 640;
  }

  .credit-note {
    margin: 18px 0 20px;
    padding: 8px 12px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-control);
    background: var(--fin-tint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--fin-deep);
  }

  .tier .btn {
    margin-top: auto;
  }

  .pricing-subtext {
    max-width: 44rem;
    margin: 36px auto 0;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .pricing-subtext a {
    color: var(--fin-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .launch-form {
    max-width: 26rem;
    margin: 40px auto 0;
  }

  .launch-form-label {
    margin: 0 0 10px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .email-form {
    display: flex;
    gap: 8px;
  }

  .email-form input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  .email-form input::placeholder {
    color: var(--ink-50);
  }

  .email-form input:focus-visible {
    outline: 2px solid var(--fin);
    outline-offset: 0;
    border-color: var(--fin);
  }

  .launch-form :global(.form-status) {
    text-align: center;
  }

  @media (max-width: 900px) {
    .tiers {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }

  @media (max-width: 480px) {
    .email-form {
      flex-direction: column;
    }
  }
</style>
