---
const tiers = [
  {
    name: "Crucible Pro",
    featured: true,
    price: {
      strike: "$299/month",
      current: "$199/month",
      badge: "Launch deal",
    },
    blurb:
      "Turn 1 weekly 10-minute brain dump into a full suite of short clips, deep-dive videos, and written posts.",
    features: [
      "4 Drafts per month",
      "Social Shorts + Deep Dives",
      "Written LinkedIn Posts",
      "Newsletters & Articles",
      "Insights & Trends (competitors, thought leaders, topics)",
      "Preserve Mode (Natural) & Remix Mode (Viral)",
      "Context Knowledge Base (Upload PDFs & Links)",
      "Free First Project Draft (No Risk)",
    ],
    cta: { label: "Start free", href: "https://crucible-generator.vercel.app/login" },
  },
  {
    name: "Enterprise",
    featured: false,
    price: { current: "Let’s talk" },
    blurb: "For teams running content at scale with custom workflows, compliance, and dedicated support.",
    features: ["Everything in Pro", "Unlimited drafts", "Custom AI model tuning", "Dedicated support", "SSO & team management"],
    cta: { label: "Contact us", href: "mailto:hello@trycrucible.com?subject=Enterprise%20Inquiry" },
  },
  {
    name: "Agency",
    featured: false,
    price: { current: "Let’s talk" },
    blurb: "For agencies managing content for multiple clients with white-label options.",
    features: [
      "Everything in Enterprise",
      "Multi-brand management",
      "Client review flows",
      "White-label exports",
      "API access",
    ],
    cta: { label: "Contact us", href: "mailto:hello@trycrucible.com?subject=Agency%20Inquiry" },
  },
];
---

<section class="section section--wash" id="pricing">
  <div class="wrap">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Pricing</p>
      <h2 class="display">Start free. <em>Pay when it’s working.</em></h2>
      <p class="lede">
        Your first project — the edited video and the full set of posts — is free. No card, no trial timer.
      </p>
    </div>
    <div class="tiers">
      {
        tiers.map((t) => (
          <article class:list={["card", "tier", { "card--highlight": t.featured }]}>
            <h3>{t.name}</h3>
            <p class="tier-price">
              {t.price.strike && <span class="strike">{t.price.strike}</span>}
              <span class:list={[{ "is-fin": t.featured }]}>{t.price.current}</span>
              {t.price.badge && <span class="badge">{t.price.badge}</span>}
            </p>
            <p class="tier-blurb">{t.blurb}</p>
            <ul class="tier-features">
              {t.features.map((f) => (
                <li>
                  <span class="mark" aria-hidden="true">✓</span>
                  {f}
                </li>
              ))}
            </ul>
            <a class:list={["btn", "btn--block", { "btn--fin": t.featured, "btn--outline": !t.featured }]} href={t.cta.href}>
              {t.cta.label}
            </a>
          </article>
        ))
      }
    </div>
    <p class="pricing-note reveal">
      Launch pricing: $199/month for Crucible Pro (regularly $299). Your first project is free — upgrade whenever
      you’re ready.
    </p>
    <div class="launch-form reveal">
      <p class="launch-form-label">Get launch updates</p>
      <form class="email-form" action="#" method="get" data-capture-form>
        <input type="email" name="email" placeholder="you@yourbusiness.com" aria-label="Email address" required />
        <button class="btn" type="submit">Notify me</button>
      </form>
    </div>
  </div>
</section>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 56px;
    align-items: stretch;
  }

  .tier {
    display: flex;
    flex-direction: column;
  }

  .tier h3 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 540;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 1.5rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .strike {
    font-size: 1.0625rem;
    font-weight: 460;
    color: var(--ink-50);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .is-fin {
    color: var(--fin-deep);
  }

  .badge {
    padding: 4px 8px;
    border-radius: var(--radius-control);
    background: var(--fin);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .tier-blurb {
    margin: 14px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .tier-features {
    list-style: none;
    margin: 20px 0 24px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .tier-features li {
    display: flex;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-80);
  }

  .mark {
    flex-shrink: 0;
    color: var(--fin-deep);
    font-weight: 640;
  }

  .tier .btn {
    margin-top: auto;
  }

  .pricing-note {
    max-width: 44rem;
    margin: 36px auto 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-60);
  }

  .launch-form {
    max-width: 26rem;
    margin: 40px auto 0;
  }

  .launch-form-label {
    margin: 0 0 10px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .email-form {
    display: flex;
    gap: 8px;
  }

  .email-form input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  .email-form input::placeholder {
    color: var(--ink-50);
  }

  .email-form input:focus-visible {
    outline: 2px solid var(--fin);
    outline-offset: 0;
    border-color: var(--fin);
  }

  @media (max-width: 900px) {
    .tiers {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }

  @media (max-width: 480px) {
    .email-form {
      flex-direction: column;
    }
  }
</style>
