---
const posts = [
  { source: "LinkedIn", body: "Most founders treat content like a chore. I treat it like a forge…", tag: "post" },
  { source: "Instagram", body: "“You’re already saying it in meetings. We just put it on camera.”", tag: "caption" },
  { source: "Blog", body: "Authority compounds: why showing up weekly beats going viral twice a year…", tag: "draft" },
];
---

<section class="section" id="sample-output">
  <div class="wrap">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Sample output</p>
      <h2 class="display">One brain dump in. <em>A whole week out.</em></h2>
      <p class="lede">Here’s what comes back from a single 10-minute recording.</p>
    </div>
    <div class="sample-grid">
      <figure class="slot slot--vertical reveal">
        <div class="slot-frame">
          <img
            src="/vertical-example.png"
            alt="Edited vertical video still — a Crucible short ready for LinkedIn, TikTok, or YouTube Shorts"
            width="432"
            height="842"
          />
        </div>
        <figcaption class="slot-caption-bar">
          <span class="slot-title">Edited vertical video still</span>
          <span class="slot-dims">720 × 1280 · 9:16</span>
        </figcaption>
      </figure>
      <figure class="slot slot--posts reveal" role="img" aria-label="Generated posts — Instagram, LinkedIn, blog — 1200 by 900">
        <div class="posts-stack">
          {posts.map((p) => (
            <div class="post-row">
              <span class="post-source">{p.source}</span>
              <p class="post-body">{p.body}</p>
              <span class="post-tag">{p.tag}</span>
            </div>
          ))}
        </div>
        <figcaption class="slot-caption-bar">
          <span class="slot-title">Generated posts</span>
          <span class="slot-dims">LinkedIn · Instagram · Blog</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .sample-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    margin-top: 56px;
    align-items: stretch;
  }

  .slot {
    margin: 0;
    border: 1px solid var(--oat);
    border-radius: var(--radius-container);
    background: var(--surface);
    box-shadow: var(--shadow-whisper);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .slot-frame {
    position: relative;
    flex: 1;
    min-height: 480px;
    overflow: hidden;
    background: var(--ink);
  }

  .slot-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slot-caption-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-top: 1px solid var(--oat);
    background: var(--canvas);
  }

  .slot-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .slot-dims {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-50);
  }

  .posts-stack {
    display: grid;
    gap: 0;
    padding: 24px;
  }

  .post-row {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    gap: 16px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid var(--oat);
  }

  .post-row:first-child {
    padding-top: 0;
  }

  .post-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .post-source {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
    padding-top: 4px;
  }

  .post-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-80);
  }

  .post-tag {
    padding: 4px 8px;
    border-radius: var(--radius-control);
    background: var(--fin-tint);
    color: var(--fin-deep);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .sample-grid {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }

    .slot-frame {
      min-height: 420px;
    }
  }

  @media (max-width: 480px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .post-tag {
      justify-self: start;
    }
  }
</style>
