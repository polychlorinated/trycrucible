---
import PageHero from "./PageHero.astro";
import FinalCta from "./FinalCta.astro";
import type { ComparisonHub } from "../data/comparisons";

interface Props {
  hub: ComparisonHub;
}

const { hub } = Astro.props;
---

<div class="wrap crumb-wrap">
  <p class="crumb reveal">
    <a href="/vs/">← All comparisons</a>
  </p>
</div>
<PageHero
  eyebrow="Comparison hub"
  title={hub.name}
  em="vs. Crucible"
  lede={hub.hook}
  ctaLabel="Start your first campaign free"
  secondaryLabel="See pricing"
  secondaryHref="/#pricing"
/>
<section class="section">
  <div class="wrap hub-wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Who this helps</p>
      <h2 class="display">
        Built for <em>people like you.</em>
      </h2>
      <p class="lede">{hub.audience}</p>
    </div>
    <div class="spokes">
      {
        hub.spokes.map((spoke) => (
          <article class="card spoke reveal">
            <p class="spoke-label">Crucible vs</p>
            <h3>{spoke.name}</h3>
            <p class="spoke-pitch">{spoke.pitch}</p>
            <a class="spoke-link" href={spoke.href}>Compare →</a>
          </article>
        ))
      }
    </div>
  </div>
</section>
<FinalCta />

<style>
  .crumb-wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }

  .crumb {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .crumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-50);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--fin-deep);
  }

  .hub-wrap {
    max-width: 960px;
  }

  .spokes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .spoke {
    display: flex;
    flex-direction: column;
  }

  .spoke-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .spoke h3 {
    margin: 8px 0 0;
    font-size: 1.25rem;
    font-weight: 540;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .spoke-pitch {
    margin: 10px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .spoke-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 14px;
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--fin-deep);
    text-decoration: none;
  }

  .spoke-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .spokes {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
