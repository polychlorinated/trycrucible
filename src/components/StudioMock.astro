---
const cutWords = [
  { text: "you know," },
  { text: "um," },
  { text: "sort of", cut: true },
  { text: "the key thing is", },
  { text: "authority", hot: true },
  { text: "compounds", },
  { text: "when you", },
  { text: "show up", },
  { text: "weekly", },
  { text: "like, literally", cut: true },
  { text: "with a point of view", },
];

const outputs = [
  { label: "60s short", note: "Hook first · LinkedIn", color: "var(--report-blue)" },
  { label: "Deep dive", note: "6 min · YouTube", color: "var(--report-lime)" },
  { label: "LinkedIn post", note: "Written · ready", color: "var(--report-pink)" },
  { label: "Newsletter", note: "Draft · editable", color: "var(--report-amber)" },
];
---

<figure class="studio" role="img" aria-label="Crucible studio — a raw recording becomes edited clips and written posts">
  <div class="studio-chrome">
    <span class="chrome-label">Crucible Studio</span>
    <span class="chrome-draft">Draft 04</span>
    <span class="chrome-rec"><i></i>Recording</span>
  </div>

  <div class="studio-body">
    <div class="video-pane">
      <div class="speaker" aria-hidden="true">
        <span class="speaker-avatar">AJ</span>
      </div>
      <div class="waveform" aria-hidden="true">
        <span style="height: 28%"></span>
        <span style="height: 46%"></span>
        <span style="height: 72%"></span>
        <span style="height: 54%"></span>
        <span style="height: 88%"></span>
        <span style="height: 64%"></span>
        <span style="height: 40%"></span>
        <span style="height: 58%"></span>
        <span style="height: 90%"></span>
        <span style="height: 70%"></span>
        <span style="height: 48%"></span>
        <span style="height: 62%"></span>
        <span style="height: 36%"></span>
        <span style="height: 74%"></span>
        <span style="height: 56%"></span>
        <span style="height: 30%"></span>
      </div>
      <div class="video-meta">
        <span>00:09:42</span>
        <span class="cut-counter">47 cuts marked</span>
      </div>
    </div>

    <div class="transcript-pane">
      <p class="pane-label">Transcript — click any word to cut it</p>
      <p class="transcript">
        {cutWords.map((w) => (
          <span
            class:list={["word", { "is-cut": w.cut, "is-hot": w.hot }]}
            aria-hidden={w.cut ? "true" : undefined}
          >
            {w.text}
          </span>
        ))}
        …
      </p>
    </div>

    <div class="outputs-pane">
      <p class="pane-label">One pass. A week of output.</p>
      <ul class="outputs">
        {outputs.map((o) => (
          <li class="output">
            <span class="output-check" style={`--chip: ${o.color}`}>✓</span>
            <span class="output-text">
              <strong>{o.label}</strong>
              <small>{o.note}</small>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="interviewer-chip" aria-hidden="true">
    <span class="chip-spark">✦</span>
    AI interviewer — follow-up: “What’s the counterargument?”
  </div>
</figure>

<style>
  .studio {
    position: relative;
    margin: 0;
    border: 1px solid var(--oat);
    border-radius: var(--radius-container);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
    overflow: visible;
  }

  .studio-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--oat);
    background: var(--canvas);
    border-radius: var(--radius-container) var(--radius-container) 0 0;
  }

  .chrome-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .chrome-draft {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-50);
  }

  .chrome-rec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .chrome-rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--report-red, #c41c1c);
    box-shadow: 0 0 0 3px rgb(196 28 28 / 0.18);
    animation: pulse 2s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .studio-body {
    display: grid;
    gap: 0;
    padding: 14px;
  }

  .video-pane {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    height: 190px;
    padding: 20px;
    border-radius: var(--radius-control);
    background: var(--ink);
    overflow: hidden;
  }

  .speaker-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--fin);
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    align-self: center;
  }

  .waveform {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    flex: 1;
    height: 90px;
  }

  .waveform span {
    flex: 1;
    border-radius: 2px;
    background: linear-gradient(to top, rgb(101 181 255 / 0.35), var(--report-blue));
    opacity: 0.9;
  }

  .video-meta {
    position: absolute;
    left: 20px;
    bottom: 14px;
    display: flex;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: rgb(250 249 246 / 0.6);
  }

  .cut-counter {
    color: var(--fin);
  }

  .pane-label {
    margin: 14px 2px 8px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .transcript-pane {
    border-top: 1px solid var(--oat);
    margin-top: 14px;
  }

  .transcript {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.9;
    color: var(--ink-80);
  }

  .word {
    padding: 2px 1px;
    border-radius: 3px;
    transition: background-color 160ms var(--ease-out);
  }

  .word.is-cut {
    color: var(--ink-50);
    text-decoration: line-through;
    text-decoration-color: var(--sand);
    text-decoration-thickness: 1.5px;
  }

  .word.is-hot {
    background: var(--fin-tint);
    color: var(--ink);
    font-weight: 560;
  }

  .outputs-pane {
    border-top: 1px solid var(--oat);
  }

  .outputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .output {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-control);
    background: var(--canvas);
  }

  .output-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--chip) 22%, var(--surface));
    color: var(--ink-80);
    font-size: 0.6875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .output-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .output-text strong {
    font-size: 0.8125rem;
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .output-text small {
    margin-top: 2px;
    font-size: 0.6875rem;
    color: var(--ink-50);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .interviewer-chip {
    position: absolute;
    right: -14px;
    bottom: -22px;
    max-width: calc(100% - 40px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--ink-60);
  }

  .chip-spark {
    color: var(--fin);
  }

  @media (max-width: 480px) {
    .outputs {
      grid-template-columns: 1fr;
    }

    .interviewer-chip {
      right: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chrome-rec i {
      animation: none;
    }
  }
</style>
