<section class="section section--dark" id="final-cta">
  <div class="wrap final-wrap">
    <h2 class="display reveal">Your next week of content is <em>one recording away.</em></h2>
    <p class="final-sub reveal">
      Set up your brand voice in a few minutes and capture your first project free.
    </p>
    <a class="btn btn--fin reveal" href="https://app.trycrucible.com/login">Capture your first project free</a>
  </div>
</section>

<style>
  .final-wrap {
    max-width: 820px;
    text-align: center;
  }

  .section--dark .display {
    color: var(--canvas);
  }

  .section--dark .display em {
    color: var(--fin);
  }

  .final-sub {
    margin: 20px auto 0;
    font-size: 1.0625rem;
    color: var(--sand);
    max-width: 32rem;
  }

  .final-wrap .btn {
    margin-top: 36px;
  }

  .btn--fin {
    background: var(--fin);
    border-color: var(--fin);
    color: var(--ink);
  }

  .btn--fin:hover {
    background: var(--canvas);
    border-color: var(--canvas);
    color: var(--ink);
  }

  .btn--fin:active {
    background: var(--fin-deep);
    color: var(--ink);
  }
</style>
