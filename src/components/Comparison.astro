---
const tiers = [
  {
    title: "Ghostwriting & Content Creation Agencies",
    price: "$2,000 – $5,000+ / month",
    items: [
      "Content research and planning are opaque, billable services tied to producer schedules.",
      "Takes days or weeks to turn around basic text or draft assets.",
      "Ghostwriters guess your stance instead of capturing your literal domain expertise.",
      "Expensive agency retainers that add another team to manage.",
    ],
    featured: false,
  },
  {
    title: "DIY Apps & Blank Prompters",
    price: "$15 – $60 / month",
    items: [
      "Zero content research: gives you a blank prompt box and expects you to do all the work.",
      "Hallucinates generic “AI slop” that damages your credibility when building your brand.",
      "Analyzes old writing samples instead of capturing your real-time thinking.",
      "Requires endless manual re-prompting and timeline scrubbing.",
    ],
    featured: false,
  },
  {
    title: "The Crucible Studio",
    price: "Highest leverage of your time and money",
    items: [
      "Research & Plan: a self-serve lab tracking competitor gaps, subreddit trends, and market green space 24/7.",
      "Zero AI slop / 100% traceable: every carousel slide and article maps directly back to what you spoke on mic.",
      "Multi-format coverage: delivers 60-second viral clips, carousels on LinkedIn, deep dives, and articles in one pass.",
      "In-app control: polish transcripts, approve outputs, and schedule directly to your connected channels.",
    ],
    featured: true,
  },
];
---

<section class="section" id="comparison">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Compare</p>
      <h2 class="display">Stop choosing between <em>$5,000 ghostwriters</em> and the AI slop trap.</h2>
      <p class="lede">
        Content creation agencies charge thousands for opaque research and slow drafts; prompt-based AI tools output generic slop that damages your credibility when building your brand.
      </p>
    </div>
    <div class="tiers">
      {
        tiers.map((t) => (
          <article class:list={["card", "tier", { "card--highlight": t.featured }]}>
            <div class="tier-head">
              <h3>{t.title}</h3>
              <p class:list={["tier-price", { "is-fin": t.featured }]}>{t.price}</p>
            </div>
            <ul class="tier-features">
              {t.items.map((item) => (
                <li>
                  {!t.featured ? <span class="mark mark--off" aria-hidden="true">—</span> : <span class="mark" aria-hidden="true">✓</span>}
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="comparison-more reveal">
      <a class="btn btn--outline" href="/vs/">More comparisons →</a>
    </p>
  </div>
</section>

<style>
  .comparison-more {
    margin: 40px 0 0;
    text-align: center;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 56px;
    align-items: stretch;
  }

  .tier {
    display: flex;
    flex-direction: column;
  }

  .tier-head h3 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 540;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tier-price {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: var(--ink-60);
  }

  .tier-price.is-fin {
    color: var(--fin-deep);
    font-weight: 500;
  }

  .tier-features {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .tier-features li {
    display: flex;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-80);
  }

  .mark {
    flex-shrink: 0;
    color: var(--fin-deep);
    font-weight: 640;
  }

  .mark--off {
    color: var(--sand);
  }

  @media (max-width: 900px) {
    .tiers {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
