---
const features = [
  { title: "60-Second Social Shorts", body: "High-impact, hook-first clips formatted for LinkedIn, TikTok, and YouTube Shorts." },
  { title: "Carousels on LinkedIn", body: "Swipeable carousel slides built from your recording’s key points — hooks, proof, and a call to action, formatted as carousels on LinkedIn that build your brand." },
  { title: "5–10 Minute Deep Dives", body: "Structured thought pieces ideal for long-form video channels, embedded newsletter updates, or customer-facing product reviews." },
  { title: "Articles on LinkedIn & Social Posts", body: "Transformed text drafts — long-form articles on LinkedIn, newsletters, and social posts — assembled directly from your spoken logic." },
  { title: "Verbatim Lineage (Zero AI Slop)", body: "Nothing is hallucinated from blank text prompts. Every slide, hook, and paragraph cites your exact spoken words. If you didn’t say it, Crucible doesn’t draft it." },
  { title: "Research & Plan", body: "A self-serve lab for what to say next: track competitor gaps, subreddit trends, and market green space, matched to your editorial backlog and prep questions." },
  { title: "In-App Approve & Schedule", body: "Full control over your content calendar. Polish any draft, approve outputs, and schedule directly to your social channels in one click." },
  { title: "Closed-Loop Measurement", body: "Built-in analytics track audience engagement, feeding performance signals directly back into your next round of content research." },
];
---

<section class="section section--wash" id="what-you-get">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">What you get</p>
      <h2 class="display">Every format your week needs, <em>from one recording.</em></h2>
    </div>
    <div class="features">
      {
        features.map((f) => (
          <article class="card feature reveal">
            <span class="feature-dot" aria-hidden="true"></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .feature {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    align-items: start;
  }

  .feature-dot {
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 2px;
    background: var(--fin);
  }

  .feature:nth-child(4n + 2) .feature-dot { background: var(--report-blue); }
  .feature:nth-child(4n + 3) .feature-dot { background: var(--report-lime); }
  .feature:nth-child(4n + 4) .feature-dot { background: var(--report-pink); }

  .feature h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .feature p {
    grid-column: 2;
    margin: 8px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  @media (max-width: 768px) {
    .features {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
