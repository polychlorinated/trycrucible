---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCta from "../components/FinalCta.astro";
import JsonLd from "../components/JsonLd.astro";
import { organizationSchema, webPageSchema, howToSchema } from "../data/seo";

const PAGE_URL = "https://trycrucible.com/how-it-works/";
const title = "How it works — The Crucible System in four steps";
const description =
  "Find your inspiration, record your raw thoughts, edit automated multi-channel results, and publish — how Crucible turns one recording into a week of content.";

const steps = [
  {
    num: "01",
    heading: "Step 1: Find your inspiration",
    body: "You already have the thoughts — Crucible gives you the hooks. The Topics tracker follows the competitors, thought leaders, and topics that matter in your space, then surfaces what people are talking about right now. Insights show where you can weigh in, and where the greenspace is yours to own. Pick an angle, and you’re ready to record.",
    image: "/topics-tracking.webp",
    imageAlt: "The Crucible topics page showing insights derived from the tracker, with the sidebar revealing the thought leaders and topics being followed",
  },
  {
    num: "02",
    heading: "Step 2: Record Your Raw Thoughts",
    body: "Recording shouldn’t feel like a performance. Choose your path: a rambling brain dump, a train of thought on the move, or an AI-guided interview — a podcast-style host that adapts to your answers and asks the follow-ups that pull your best ideas to the surface. No calendar coordination, no blank-page anxiety. Just talk the way you normally talk; Crucible handles the stumbles.",
    video: "/interview-studio-demo.mp4",
    videoCaption: "A user being interviewed by the AI interviewer, responding to questions in the studio",
  },
  {
    num: "03",
    heading: "Step 3: Edit Automated Multi-Channel Results",
    body: "From one recording, Crucible drafts your whole week: 60-second clips, deep-dive videos, LinkedIn posts, newsletters, and blog articles — all in your voice. Then you’re in control. Review any draft and approve or rewrite it, or open the transcript and click any word to cut it — the video re-renders to match your edits. No timeline scrubbing, no re-recording.",
    images: [
      { src: "/draft-edit.webp", alt: "A draft LinkedIn post generated by Crucible with editing tools to approve or rewrite" },
      { src: "/transcript-edit.webp", alt: "A video clip with its active transcript, where several words have been selected for deletion before re-processing" },
    ],
  },
  {
    num: "04",
    heading: "Step 4: Publish and monitor your brand growth",
    body: "Ship everything from your dashboard. Download the finished files, or connect LinkedIn and publish posts straight from Crucible. Every campaign compounds: consistent weekly presence is what turns the market’s attention into trust — and trust into growth you can watch in your analytics.",
    video: "/demo-clip-final.mp4",
    videoCaption: "The final short clip, lightly edited through the transcript tool and ready to publish",
    image: "/published-post.webp",
    imageAlt: "A LinkedIn post published directly from Crucible",
  },
];

const howToSteps = [
  {
    name: "Step 1: Find your inspiration",
    text: "Use the Topics tracker to follow competitors, thought leaders, and topics. Insights surface what your market is talking about and where the greenspace is yours.",
    image: "/topics-tracking.webp",
  },
  {
    name: "Step 2: Record Your Raw Thoughts",
    text: "Record a raw brain dump, a train of thought, or an AI-guided interview that draws your best ideas out.",
    video: "/interview-studio-demo.mp4",
    videoName: "AI interviewer studio demo",
  },
  {
    name: "Step 3: Edit Automated Multi-Channel Results",
    text: "Review auto-generated clips, deep dives, and written drafts. Approve or rewrite posts, and click any transcript word to cut it — the video re-renders.",
    image: "/draft-edit.webp",
  },
  {
    name: "Step 4: Publish and monitor your brand growth",
    text: "Download finished files or publish posts straight to LinkedIn, then monitor how consistent weekly presence compounds into brand growth.",
    video: "/demo-clip-final.mp4",
    videoName: "Final short clip derived from the raw recording",
  },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd data={organizationSchema()} />
    <JsonLd data={webPageSchema(PAGE_URL, title, description)} />
    <JsonLd data={howToSchema("How Crucible works", description, howToSteps)} />
  </Fragment>
  <Header />
  <main>
    <section class="hiw-hero">
      <div class="wrap hiw-wrap">
        <p class="eyebrow reveal">The Crucible System</p>
        <h1 class="hiw-title reveal">
          Four steps. Ten minutes. <em>A week of content.</em>
        </h1>
        <p class="hiw-lede reveal">
          Crucible takes you from a raw recording to published clips, deep dives, and written posts —
          without the blank screen, the timeline scrubbing, or the $5,000/month ghostwriter.
        </p>
        <div class="hiw-ctas reveal">
          <a class="btn btn--fin" href="https://app.trycrucible.com/login">Start your first campaign free</a>
          <a class="btn btn--outline" href="/#pricing">See pricing</a>
        </div>
        <p class="hiw-micro reveal">No credit card · 1 free credit for your first project · No watermarks</p>
      </div>
    </section>

    <section class="hiw-steps">
      <div class="wrap hiw-wrap">
        {
          steps.map((step, i) => (
            <div class:list={["step", { "step--flip": i % 2 === 1 }]}>
              <div class="step-copy reveal">
                <p class="step-num">{step.num}</p>
                <h2>{step.heading}</h2>
                <p class="step-body">{step.body}</p>
              </div>
              <div class="step-media reveal">
                {
                  step.video && (
                    <figure class="media-frame">
                      <video controls playsinline preload="metadata">
                        <source src={step.video} type="video/mp4" />
                        Your browser does not support the video tag.
                      </video>
                      <figcaption>{step.videoCaption}</figcaption>
                    </figure>
                  )
                }
                {
                  step.image && !step.images && (
                    <figure class="media-frame">
                      <img src={step.image} alt={step.imageAlt} loading="lazy" />
                      <figcaption>{step.imageAlt}</figcaption>
                    </figure>
                  )
                }
                {
                  step.images && (
                    <div class="media-pair">
                      {
                        step.images.map((img) => (
                          <figure class="media-frame">
                            <img src={img.src} alt={img.alt} loading="lazy" />
                            <figcaption>{img.alt}</figcaption>
                          </figure>
                        ))
                      }
                    </div>
                  )
                }
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
</Layout>

<style>
  .hiw-hero {
    padding: 88px 0 0;
  }

  .hiw-wrap {
    max-width: 960px;
  }

  .hiw-title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 430;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hiw-title em {
    font-style: normal;
    color: var(--fin);
  }

  .hiw-lede {
    margin: 24px 0 0;
    max-width: 40rem;
    font-size: 1.0625rem;
    color: var(--ink-60);
  }

  .hiw-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hiw-micro {
    margin: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-50);
  }

  .hiw-steps {
    padding: 96px 0 0;
    display: grid;
    gap: 88px;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }

  .step--flip .step-copy {
    order: 2;
  }

  .step--flip .step-media {
    order: 1;
  }

  .step-num {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fin);
  }

  .step h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 540;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .step-body {
    margin: 16px 0 0;
    font-size: 1rem;
    color: var(--ink-60);
  }

  .media-frame {
    margin: 0;
    border: 1px solid var(--oat);
    border-radius: var(--radius-container);
    background: var(--surface);
    box-shadow: var(--shadow-whisper);
    overflow: hidden;
  }

  .media-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .media-frame video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .media-frame figcaption {
    padding: 10px 14px;
    border-top: 1px solid var(--oat);
    background: var(--canvas);
    font-size: 0.8125rem;
    color: var(--ink-50);
  }

  .media-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .step {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .step--flip .step-copy,
    .step--flip .step-media {
      order: initial;
    }

    .hiw-steps {
      gap: 64px;
      padding-top: 64px;
    }

    .media-pair {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hiw-hero {
      padding: 64px 0 0;
    }
  }
</style>
