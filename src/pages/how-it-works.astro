---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCta from "../components/FinalCta.astro";
import JsonLd from "../components/JsonLd.astro";
import { organizationSchema, webPageSchema, howToSchema } from "../data/seo";

const PAGE_URL = "https://trycrucible.com/how-it-works/";
const title = "How it works — Automated Content Creation in Four Steps | Crucible";
const description =
  "From content research to published carousels on LinkedIn, clips, and zero-slop articles: see how Crucible turns 10 minutes of talking into a full week of content.";

const steps = [
  {
    heading: "Step 1: Research & Plan",
    body: "Unlike content creation agencies that hide research behind closed doors, Crucible gives you a self-serve lab for what to say next. Market signals scan competitor gaps, rising subreddit trends, and thought-leader blind spots to find your green space. Topics and themes maintain an ongoing idea library in your brand voice, while Director prep questions and context documents ensure you enter every recording with clarity.",
    image: "/topics-tracking.webp",
    imageAlt: "The Crucible topics page showing insights derived from the tracker, with the sidebar revealing the thought leaders and topics being followed",
  },
  {
    heading: "Step 2: Record Your Raw Thoughts",
    body: "Recording shouldn’t feel like a performance. Choose your path: a rambling brain dump, a train of thought on the move, or an AI-guided audio interview that draws your best ideas out in your authentic voice. No calendar coordination, no blank-page anxiety. Just talk the way you normally talk; Crucible handles the stumbles.",
    video: "/interview-studio-demo.mp4",
    videoCaption: "A user being interviewed by the AI interviewer, responding to questions in the studio",
  },
  {
    heading: "Step 3: Edit Automated Multi-Channel Results",
    body: "From one recording, Crucible drafts your whole week: 60-second clips, carousels on LinkedIn, deep-dives, articles on LinkedIn, newsletters, and blog posts — all in your voice. Every output has verbatim lineage to what you spoke on mic. Review any draft, approve or edit in-app, or open the transcript and click any word to cut it — the clip re-renders to match your edits.",
    images: [
      { src: "/draft-edit.webp", alt: "A draft LinkedIn post generated by Crucible with editing tools to approve or rewrite" },
      { src: "/transcript-edit.webp", alt: "A video clip with its active transcript, where several words have been selected for deletion before re-processing" },
    ],
  },
  {
    heading: "Step 4: Approve, Publish, and Measure",
    body: "Approve, schedule, and ship everything from your dashboard. Download the finished files or publish directly to your connected platforms — LinkedIn, X, and more. Built-in engagement analytics track what resonates across channels, feeding performance signals right back into your research loop for what to tackle next.",
    watchLabel: "Watch a final cut",
    video: "/demo-clip-final.mp4",
    videoCaption: "The final short clip, lightly edited through the transcript tool and ready to publish",
    image: "/published-post.webp",
    imageAlt: "A LinkedIn post published directly from Crucible",
  },
];

const howToSteps = [
  {
    name: "Step 1: Research & Plan",
    text: "Use the Research & Plan lab to track market signals, competitor gaps, and subreddit trends. Match opportunities to your editorial backlog and Director prep questions.",
    image: "/topics-tracking.webp",
  },
  {
    name: "Step 2: Record Your Raw Thoughts",
    text: "Record a raw brain dump, a train of thought, or an AI-guided audio interview that draws your best ideas out in your real voice.",
    video: "/interview-studio-demo.mp4",
    videoName: "AI interviewer studio demo",
  },
  {
    name: "Step 3: Edit Automated Multi-Channel Results",
    text: "Review automated clips, carousels on LinkedIn, deep dives, and articles. Approve or rewrite posts, and click any transcript word to cut it — the clip re-renders.",
    image: "/draft-edit.webp",
  },
  {
    name: "Step 4: Approve, Publish, and Measure",
    text: "Approve and schedule posts directly to your connected platforms, then monitor how performance signals feed back into your content research loop.",
    video: "/demo-clip-final.mp4",
    videoName: "Final short clip derived from the raw recording",
  },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd data={organizationSchema()} />
    <JsonLd data={webPageSchema(PAGE_URL, title, description)} />
    <JsonLd data={howToSchema("How Crucible works", description, howToSteps)} />
  </Fragment>
  <Header />
  <main>
    <section class="hiw-hero">
      <div class="wrap hiw-wrap">
        <p class="eyebrow reveal">The Crucible System</p>
        <h1 class="hiw-title reveal">
          Four steps. Ten minutes. <em>A week of content.</em>
        </h1>
        <p class="hiw-lede reveal">
          Crucible takes you from content research to published clips, carousels on LinkedIn, deep dives, and
          articles — without the blank screen, the timeline scrubbing, or the $5,000/month ghostwriter.
        </p>
        <div class="hiw-ctas reveal">
          <a class="btn btn--fin" href="https://app.trycrucible.com/login">Start your first campaign free</a>
          <a class="btn btn--outline" href="/#pricing">See pricing</a>
        </div>
        <p class="hiw-micro reveal">No credit card · 1 free credit for your first project · No watermarks</p>
      </div>
    </section>

    <section class="hiw-steps">
      <div class="wrap hiw-steps-wrap">
        {
          steps.map((step, i) => (
            <div class="step">
              <div class="step-copy reveal">
                <h2>{step.heading}</h2>
                <p class="step-body">{step.body}</p>
                {
                  step.watchLabel && (
                    <p class="step-action">
                      <button class="btn btn--outline" type="button" data-video-open={`final-cut-${i}`}>
                        {step.watchLabel}
                      </button>
                    </p>
                  )
                }
              </div>
              <div class="step-media reveal">
                {
                  step.video && !step.watchLabel && (
                    <figure class="media-full">
                      <video controls playsinline preload="metadata">
                        <source src={step.video} type="video/mp4" />
                        Your browser does not support the video tag.
                      </video>
                      <figcaption>{step.videoCaption}</figcaption>
                    </figure>
                  )
                }
                {
                  step.image && !step.images && (
                    <figure class:list={["media-full", { "media-portrait": step.watchLabel }]}>
                      <img src={step.image} alt={step.imageAlt} loading="lazy" />
                      <figcaption>{step.imageAlt}</figcaption>
                    </figure>
                  )
                }
                {
                  step.images && (
                    <div class="media-stack">
                      {
                        step.images.map((img) => (
                          <figure class="media-full">
                            <img src={img.src} alt={img.alt} loading="lazy" />
                            <figcaption>{img.alt}</figcaption>
                          </figure>
                        ))
                      }
                    </div>
                  )
                }
                {
                  step.watchLabel && step.video && (
                    <dialog class="video-modal" id={`final-cut-${i}`}>
                      <div class="video-modal-inner">
                        <button class="video-modal-close" type="button" data-video-close aria-label="Close video">
                          ✕
                        </button>
                        <video controls playsinline preload="metadata">
                          <source src={step.video} type="video/mp4" />
                          Your browser does not support the video tag.
                        </video>
                      </div>
                    </dialog>
                  )
                }
              </div>
              {
                i < steps.length - 1 && (
                  <div class="step-connector reveal" aria-hidden="true"><span></span>↓<span></span></div>
                )
              }
            </div>
          ))
        }
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
</Layout>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.video-modal")) {
    const openers = document.querySelectorAll<HTMLElement>(`[data-video-open="${dialog.id}"]`);
    const closeBtn = dialog.querySelector<HTMLElement>("[data-video-close]");

    for (const opener of openers) {
      opener.addEventListener("click", () => dialog.showModal());
    }
    closeBtn?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      dialog.querySelector("video")?.pause();
    });
  }
</script>

<style>
  .hiw-hero {
    padding: 88px 0 0;
  }

  .hiw-wrap {
    max-width: 960px;
  }

  .hiw-title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 430;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hiw-title em {
    font-style: normal;
    color: var(--fin);
  }

  .hiw-lede {
    margin: 24px 0 0;
    max-width: 40rem;
    font-size: 1.0625rem;
    color: var(--ink-60);
  }

  .hiw-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hiw-micro {
    margin: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-50);
  }

  .hiw-steps {
    padding: 112px 0 0;
  }

  .hiw-steps-wrap {
    max-width: 1040px;
  }

  .step {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .step + .step {
    margin-top: 120px;
  }

  .step-copy {
    max-width: 44rem;
    margin: 0 auto;
    text-align: center;
  }

  .step h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 540;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .step-body {
    margin: 16px auto 0;
    font-size: 1rem;
    color: var(--ink-60);
    text-align: left;
  }

  .step-action {
    margin: 28px 0 0;
  }

  .media-full {
    width: 100%;
    margin: 0 auto;
    max-width: 960px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-container);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }

  .media-full img {
    display: block;
    width: 100%;
    height: auto;
  }

  .media-full video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .media-full figcaption {
    padding: 12px 16px;
    border-top: 1px solid var(--oat);
    background: var(--canvas);
    font-size: 0.8125rem;
    color: var(--ink-50);
  }

  .media-stack {
    display: grid;
    gap: 32px;
  }

  .media-portrait {
    max-width: 420px;
  }

  .step-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--sand);
    font-size: 1rem;
  }

  .step-connector span {
    width: 72px;
    height: 1px;
    background: var(--oat);
  }

  .video-modal {
    width: min(920px, calc(100vw - 48px));
    max-width: none;
    padding: 0;
    border: 1px solid var(--oat);
    border-radius: var(--radius-container);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }

  .video-modal::backdrop {
    background: rgb(17 17 17 / 0.6);
  }

  .video-modal-inner {
    position: relative;
    padding: 12px;
  }

  .video-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--oat);
    border-radius: var(--radius-control);
    background: var(--canvas);
    color: var(--ink);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .video-modal-close:hover {
    background: var(--wash);
  }

  .video-modal video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-control);
    background: var(--ink);
  }

  @media (max-width: 640px) {
    .hiw-hero {
      padding: 64px 0 0;
    }

    .hiw-steps {
      padding-top: 80px;
    }

    .step + .step {
      margin-top: 88px;
    }

    .video-modal-close {
      top: 16px;
      right: 16px;
    }
  }
</style>
