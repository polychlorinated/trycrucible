---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ComparisonHub from "../../components/ComparisonHub.astro";
import JsonLd from "../../components/JsonLd.astro";
import { hubBySlug } from "../../data/comparisons";
import { organizationSchema, webPageSchema } from "../../data/seo";

const hub = hubBySlug("linkedin-growth-tools")!;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={hub.title} description={hub.description}>
  <Fragment slot="head">
    <JsonLd data={organizationSchema()} />
    <JsonLd data={webPageSchema(pageUrl, hub.title, hub.description)} />
  </Fragment>
  <Header />
  <main>
    <ComparisonHub hub={hub} />
  </main>
  <Footer />
</Layout>
