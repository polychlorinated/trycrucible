---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TheSystem from "../components/TheSystem.astro";
import WhoItsFor from "../components/WhoItsFor.astro";
import Comparison from "../components/Comparison.astro";
import WhatYouGet from "../components/WhatYouGet.astro";
import SampleOutput from "../components/SampleOutput.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { homeFaqs } from "../data/faq";
import { organizationSchema, webSiteSchema, softwareApplicationSchema, faqPageSchema } from "../data/seo";
---

<Layout
  title="Crucible — Automated Content Creation Studio & Ghostwriting Alternative"
  description="Crucible is an automated content creation studio and ghostwriter alternative. Use real-time content research to find market green space, record your real voice, and turn 10 minutes into carousels on LinkedIn, clips, and zero-slop articles."
>
  <Fragment slot="head">
    <JsonLd data={organizationSchema()} />
    <JsonLd data={webSiteSchema()} />
    <JsonLd data={softwareApplicationSchema()} />
    <JsonLd data={faqPageSchema(homeFaqs)} />
  </Fragment>
  <Header />
  <main>
    <Hero />
    <TheSystem />
    <WhoItsFor />
    <Comparison />
    <WhatYouGet />
    <SampleOutput />
    <Pricing />
    <Faq id="faq" eyebrow="FAQ" title="Questions," em="answered." faqs={homeFaqs} />
    <FinalCta />
  </main>
  <Footer />
</Layout>
