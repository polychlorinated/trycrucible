---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhoItsFor from "../components/WhoItsFor.astro";
import Comparison from "../components/Comparison.astro";
import WhatYouGet from "../components/WhatYouGet.astro";
import SampleOutput from "../components/SampleOutput.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { homeFaqs } from "../data/faq";
import { organizationSchema, webSiteSchema, softwareApplicationSchema, faqPageSchema } from "../data/seo";
---

<Layout
  title="Crucible — Brain dump your ideas in 10 minutes. Check every content box for the week."
  description="Share your raw running commentary, and Crucible reworks your exact words into 60-second social clips, 5–10 minute deep-dive thought pieces, and ready-to-publish written posts."
>
  <Fragment slot="head">
    <JsonLd data={organizationSchema()} />
    <JsonLd data={webSiteSchema()} />
    <JsonLd data={softwareApplicationSchema()} />
    <JsonLd data={faqPageSchema(homeFaqs)} />
  </Fragment>
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <WhoItsFor />
    <Comparison />
    <WhatYouGet />
    <SampleOutput />
    <Pricing />
    <Faq id="faq" eyebrow="FAQ" title="Questions," em="answered." faqs={homeFaqs} />
    <FinalCta />
  </main>
  <Footer />
</Layout>
